@rendermode InteractiveServer
@implements IDisposable
@inject Aquarella.Services.BusinessProfileStore ProfileStore
@inject Aquarella.Services.Accounts.AccountSession Session
@inject Aquarella.Services.NoticesStore Notices

<header class="business-header">
    <div class="business-title">
        <button id="tour-menu" class="menu-button scroll-reveal" type="button" aria-label="@($"Abrir menú de {identity.Name}")"
                aria-expanded="@menuOpen" aria-controls="business-menu" @onclick="OpenMenu" @ref="menuButton">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16 M4 12h16 M4 18h16" /></svg>
        </button>
        <a class="business-name scroll-reveal" href="/" aria-label="@($"{identity.Name}, inicio")">@identity.Name</a>
        <a id="tour-profile" class="brand-mark scroll-reveal" href="/perfil" aria-label="Ir a Perfil">
            @if (identity.LogoDataUrl is not null)
            {
                <img src="@identity.LogoDataUrl" alt="@($"Logo de {identity.Name}")" />
            }
            else
            {
                @identity.Name.Trim().Substring(0, 1).ToUpperInvariant()
            }
        </a>
    </div>
    <div class="navigation-bar">
        <div class="search-container">
            <label class="sr-only" for="global-search">Buscar módulos</label>
            <div id="tour-search" class="search-field scroll-reveal">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg>
                <input id="global-search" type="search" placeholder="¿Qué estás buscando?"
                       autocomplete="off" @bind="query" @bind:event="oninput" />
                <span class="search-hint">Buscar módulos</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="search-results" aria-live="polite">
                    @if (Matches.Count == 0)
                    {
                        <p>No encontramos módulos con ese nombre.</p>
                    }
                    @foreach (var module in Matches)
                    {
                        <a href="@module.Route" @onclick="ClearSearch">@module.Title <span aria-hidden="true">↗</span></a>
                    }
                </div>
            }
        </div>
        </div>
    @if (Session.Notice is not null) { <p class="session-notice" role="status">@Session.Notice</p> }
</header>

<div class="drawer-layer @(menuOpen ? "is-open" : "")" inert="@(!menuOpen)">
    <button class="drawer-backdrop" type="button" tabindex="-1" aria-label="Cerrar menú" @onclick="CloseMenu"></button>
    <aside id="business-menu" class="menu-panel" role="dialog" aria-modal="true" aria-label="@($"Menú de {identity.Name}")" @onkeydown="HandleMenuKey">
        <div class="drawer-heading">
            <strong>@identity.Name</strong>
            <button class="menu-button" type="button" aria-label="Cerrar menú" @onclick="CloseMenu" @ref="closeButton">✕</button>
        </div>
        <nav aria-label="Navegación principal">
            <a href="/" @onclick="CloseMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3z M9 20v-7h6v7" /></svg><span>Inicio</span></a>
            @foreach (var module in ModuleCatalog.All)
            {
                <a href="@module.Route" @onclick="CloseMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@module.IconPath" /></svg><span>@module.Title</span>
                    @if (module.Route == "/avisos" && Notices.Ready && Notices.Error is null && Notices.Items.Count > 0)
                    {
                        <span class="notice-badge" aria-label="@($"{Notices.Items.Count} problemas activos, hay avisos críticos")">@Notices.Items.Count</span>
                    }
                </a>
            }
            <a href="/conversaciones/chat" @onclick="CloseMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v12H9l-5 4z M8 8h8 M8 12h5" /></svg><span>Chat de Aquarella</span></a>
            <a href="/configuracion-pagina" @onclick="CloseMenu" @ref="lastMenuLink"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16 M4 12h16 M4 18h16 M8 4v4 M16 10v4 M10 16v4" /></svg><span>Configuración de página</span></a>
            @if (Session.IsSignedIn) {
                <span class="session-user">@Session.DisplayName</span><a href="/mi-cuenta" data-enhance-nav="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></svg><span>Mi cuenta</span></a>
                <form method="post" action="/mi-cuenta?handler=Logout" data-enhance="false"><AntiforgeryToken /><button class="session-link" type="submit">Cerrar sesión</button></form>
            } else { <a href="/login" @onclick="CloseMenu">Iniciar sesión</a> }
        </nav>
    </aside>
</div>

@code {
    private Aquarella.Models.BusinessProfile identity = new();
    protected override void OnInitialized()
    {
        identity = ProfileStore.Load();
        ProfileStore.Changed += IdentityChanged;
        Session.Changed += IdentityChanged;
        Notices.Changed += NoticesChanged;
    }
    private void IdentityChanged() => _ = InvokeAsync(() => { identity = ProfileStore.Load(); StateHasChanged(); });
    private void NoticesChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { ProfileStore.Changed -= IdentityChanged; Session.Changed -= IdentityChanged; Notices.Changed -= NoticesChanged; }
    private bool menuOpen;
    private bool focusMenu;
    private string query = string.Empty;
    private ElementReference menuButton, closeButton, lastMenuLink;
    private List<ModuleCatalog.Module> Matches => ModuleCatalog.All.Where(module =>
        System.Globalization.CultureInfo.GetCultureInfo("es").CompareInfo.IndexOf(
            module.Title, query.Trim(), System.Globalization.CompareOptions.IgnoreCase |
            System.Globalization.CompareOptions.IgnoreNonSpace) >= 0).ToList();
    private void OpenMenu() { menuOpen = true; focusMenu = true; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await Session.InitializeAsync(); } catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { }
            try { await ProfileStore.InitializeAsync(); }
            catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { /* Keep the default identity if browser storage is unavailable. */ }
            if (Session.IsSignedIn) await Notices.InitializeAsync();
        }
        if (focusMenu) { focusMenu = false; await closeButton.FocusAsync(); }
    }
    private async Task CloseMenu() { menuOpen = false; await menuButton.FocusAsync(); }
    private async Task HandleMenuKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseMenu();
    }
    private void ClearSearch() => query = string.Empty;
}






