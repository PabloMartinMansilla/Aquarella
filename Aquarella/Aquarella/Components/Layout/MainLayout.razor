@inherits LayoutComponentBase
@inject Aquarella.Services.Accounts.AccountSession Session
@inject NavigationManager Navigation

<div class="app-shell">
    @if (Session.IsSignedIn) { <BusinessHeader /> }
    <div class="page-content" @key="Navigation.Uri">@Body</div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un problema. Recargá la página para volver a intentar.
    <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar aviso">🗙</button>
</div>

