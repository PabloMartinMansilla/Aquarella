@page "/metricas"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Aquarella.Models
@using System.Globalization
@inject Aquarella.Services.MetricsService Metrics
@inject Aquarella.Services.BusinessData Data
@inject IJSRuntime JS
@inject ILogger<Metricas> Logger

<PageTitle>Métricas · Aquarella</PageTitle>
<main class="module-page metrics-page" @ref="page">
    <BackToDashboard Prominent="true" />
    <div class="intro-row"><div><h1>Métricas</h1><p class="scope-note">Inventario actual · Valores potenciales, no ventas realizadas.</p></div><button class="refresh-button" @onclick="Load" disabled="@loading" aria-busy="@loading">@(loading ? "Actualizando…" : "Actualizar")</button></div>
    @if (error is not null)
    {
        <section class="surface" role="alert"><h2>No pudimos actualizar las métricas</h2><p>@error</p><button class="refresh-button" @onclick="Load">Volver a intentar</button></section>
    }
    else if (snapshot is null) { <p role="status">Cargando métricas…</p> }
    else if (snapshot.ProductCount == 0)
    {
        <section class="surface empty-metrics"><span class="empty-symbol" aria-hidden="true">▥</span><h2>Todavía no hay datos suficientes</h2><p>Empezá con tus productos.</p><a class="action-link" href="/stock">Ir a Stock <span aria-hidden="true">↗</span></a></section>
    }
    else
    {
        <div @key="revision">
        <section class="metric-grid" aria-label="Resumen del inventario">
            <MetricKpi Title="Inventario a costo" Value="snapshot.InventoryCost" Format="money" Note="@Coverage(snapshot.ProductsWithCost, snapshot.ProductsInStock)" Help="Suma del costo por las unidades disponibles. Solo incluye productos con costo mayor que cero; un costo cero todavía no distingue un dato pendiente de una adquisición gratuita." />
            <MetricKpi Title="Valor potencial de venta" Value="snapshot.InventorySaleValue" Format="money" Note="@Coverage(snapshot.ProductsWithSalePrice, snapshot.ProductsInStock)" Help="Suma del precio efectivo de venta por las unidades disponibles con precio configurado. No representa ingresos realizados." />
            <MetricKpi Title="Ganancia sobre el costo" Value="snapshot.WeightedProfitPercent" Format="percent" Note="Potencial · ponderada por stock" Help="(Venta − costo) ÷ costo × 100, ponderado por unidades. Usa los mismos productos con costo en ambos valores. No es un margen sobre ventas." />
            <MetricKpi Title="Unidades disponibles" Value="snapshot.Units" Help="Suma de las cantidades actuales de todos los productos." />
            <MetricKpi Title="Productos" Value="snapshot.ProductCount" Help="Productos registrados en Stock, incluyendo los que no tienen unidades." />
            <MetricKpi Title="Sin stock" Value="snapshot.OutOfStock" Help="Productos sin unidades disponibles." Href="/stock" LinkText="Revisar Stock" />
        </section>
        <div class="chart-grid">
            <section class="surface profit-chart" data-metric-surface aria-labelledby="profit-products">
                <div class="section-heading"><div><h2 id="profit-products">Ganancia por producto</h2><p class="hint">% sobre costo · hasta 5 por grupo</p></div><a class="text-link" href="/precios">Precios ↗</a></div>
                @if (snapshot.ProductsWithProfit == 0) { <p class="chart-empty">Agregá costos para comparar productos.</p> }
                else
                {
                    <div class="ranking-grid @(snapshot.ProductsWithProfit <= 5 ? "single-ranking" : "")">
                        <div>@if (snapshot.ProductsWithProfit > 5) { <h3>Mayor ganancia</h3> }<MetricProductList Products="snapshot.HighestProfit" Scale="@ProfitScale" /></div>
                        @if (snapshot.ProductsWithProfit > 5) { <div><h3>Menor ganancia</h3><MetricProductList Products="snapshot.LowestProfit" Scale="@ProfitScale" /></div> }
                    </div>
                    <p class="hint coverage-caption">← Pérdida · 0 · Ganancia → · Escala común ±@Percent(ProfitScale)<br />@Count(snapshot.ProductsWithProfit) / @Count(snapshot.ProductCount) con costo · incluye productos sin stock</p>
                }
            </section>
            <section class="surface stock-chart" data-metric-surface aria-labelledby="stock-distribution">
                <h2 id="stock-distribution">Distribución de stock</h2>
                <div class="donut-wrap">
                    <svg class="stock-donut" viewBox="0 0 120 120" role="img" aria-label="@($" {Count(snapshot.ProductsInStock)} productos con stock y {Count(snapshot.OutOfStock)} sin stock")">
                        <circle class="donut-track" cx="60" cy="60" r="48" />
                        <circle class="donut-arc in-stock" cx="60" cy="60" r="48" pathLength="100" stroke-dasharray="@($"{Invariant(StockPercent)} {Invariant(100m - StockPercent)}")" data-metric-ring data-ring-value="@Invariant(StockPercent)" />
                        <circle class="donut-arc out-stock" cx="60" cy="60" r="48" pathLength="100" stroke-dasharray="@($"{Invariant(100m - StockPercent)} {Invariant(StockPercent)}")" stroke-dashoffset="@Invariant(-StockPercent)" data-metric-ring data-ring-value="@Invariant(100m - StockPercent)" />
                    </svg>
                    <div class="donut-center" aria-hidden="true"><strong>@Count(snapshot.ProductCount)</strong><span>productos</span></div>
                </div>
                <div class="stock-legend">
                    <details><summary><span class="legend-dot normal"></span><span>Con stock</span><strong>@Count(snapshot.ProductsInStock)</strong></summary><p>@Percent(StockPercent) del catálogo tiene unidades disponibles.</p></details>
                    <details><summary><span class="legend-dot critical"></span><span>Sin stock</span><strong>@Count(snapshot.OutOfStock)</strong></summary><p>@Percent(100m - StockPercent) del catálogo no tiene unidades disponibles. <a href="/stock">Revisar Stock ↗</a></p></details>
                </div>
            </section>
        </div>
        <div class="secondary-grid">
            <section class="surface" data-metric-surface aria-labelledby="pricing-coverage">
                <div class="section-heading"><h2 id="pricing-coverage">Cobertura de precios</h2><a class="text-link" href="/precios">Completar ↗</a></div>
                @if (snapshot.ProductsInStock == 0) { <p class="chart-empty">No hay productos con unidades disponibles.</p> }
                else
                {
                    <div class="coverage-item"><div><span>Costo registrado</span><strong>@Count(snapshot.ProductsWithCost) / @Count(snapshot.ProductsInStock)</strong></div><div class="progress-track" role="progressbar" aria-label="Productos con stock y costo registrado" aria-valuemin="0" aria-valuemax="@snapshot.ProductsInStock" aria-valuenow="@snapshot.ProductsWithCost"><span data-metric-bar style="@($"width:{Invariant(Ratio(snapshot.ProductsWithCost, snapshot.ProductsInStock))}%")"></span></div></div>
                    <div class="coverage-item"><div><span>Precio de venta</span><strong>@Count(snapshot.ProductsWithSalePrice) / @Count(snapshot.ProductsInStock)</strong></div><div class="progress-track" role="progressbar" aria-label="Productos con stock y precio de venta" aria-valuemin="0" aria-valuemax="@snapshot.ProductsInStock" aria-valuenow="@snapshot.ProductsWithSalePrice"><span data-metric-bar style="@($"width:{Invariant(Ratio(snapshot.ProductsWithSalePrice, snapshot.ProductsInStock))}%")"></span></div></div>
                    <p class="hint">Sobre productos con stock. Los importes son parciales si faltan datos.</p>
                }
            </section>
            <section class="surface" data-metric-surface aria-labelledby="active-problems">
                <div class="section-heading"><h2 id="active-problems">Avisos activos <span class="total-badge">@Count(snapshot.ActiveNotices)</span></h2><a class="text-link" href="/avisos">Revisar ↗</a></div>
                @if (snapshot.ActiveNotices == 0) { <p class="chart-empty">✓ Sin avisos pendientes.</p> }
                else
                {
                    <ul class="cause-list">
                        @foreach (var notice in snapshot.Notices)
                        {
                            <li><details><summary><span>@NoticeTitle(notice.Kind)</span><strong>@Count(notice.Count)</strong><div class="progress-track" aria-hidden="true"><span class="@(notice.Severity == NoticeSeverity.Critical ? "critical" : "attention")" data-metric-bar style="@($"width:{Invariant(Ratio(notice.Count, snapshot.Notices.Max(n => n.Count)))}%")"></span></div></summary><p>@(notice.Severity == NoticeSeverity.Critical ? "Crítico" : "Atención") · @Count(notice.Count) productos. Las barras comparan cantidades; los problemas pueden coincidir en un mismo producto.</p></details></li>
                        }
                    </ul>
                    <p class="hint">Un producto puede tener más de un aviso.</p>
                }
            </section>
        </div>
        </div>
    }
</main>
@code {
    private BusinessMetrics? snapshot;
    private string? error;
    private bool loading, pending, disposed;
    private bool motionPending;
    private int revision;
    private ElementReference page;
    private IJSObjectReference? motion;
    private bool importing;
    private readonly CancellationTokenSource lifetime = new();
    protected override void OnInitialized() => Data.NoticesChanged += DataChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await Load(); return; }
        if (!motionPending || disposed || importing) return;
        motionPending = false;
        try
        {
            if (motion is null)
            {
                importing = true;
                try
                {
                    var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./metrics-motion.js");
                    if (disposed) { await Aquarella.Services.BrowserModuleLifetime.ReleaseAsync(imported); return; }
                    motion = imported;
                }
                finally { importing = false; }
            }
            motionPending = false;
            if (!disposed) await motion.InvokeVoidAsync("enter", page);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { /* Presentation only; final values already render without JS. */ }
    }
    private void DataChanged() { if (!disposed) _ = ReloadAfterChange(); }
    private async Task ReloadAfterChange()
    {
        try { if (!disposed) await InvokeAsync(Load); }
        catch (Exception e) when (disposed && e is OperationCanceledException or ObjectDisposedException or InvalidOperationException) { }
        catch (Exception e) { Logger.LogWarning(e, "Metrics view refresh failed."); }
    }
    private async Task Load()
    {
        if (disposed) return;
        if (loading) { pending = true; return; }
        loading = true;
        try { do
        {
            pending = false;
            try { var loaded = await Metrics.LoadAsync(lifetime.Token); if (!disposed) { snapshot = loaded; error = null; revision++; motionPending = true; } }
            catch (OperationCanceledException) when (disposed) { }
            catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { error = "Los datos guardados se conservaron. Revisá la conexión e intentá nuevamente."; }
        } while (pending && !disposed);
        } finally { loading = false; }
        if (!disposed) await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true; lifetime.Cancel(); lifetime.Dispose();
        Data.NoticesChanged -= DataChanged;
        if (motion is null) return;
        await Aquarella.Services.BrowserModuleLifetime.ReleaseAsync(motion, "dispose", page);
    }
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("es-AR");
    private static string Count(long value) => value.ToString("N0", Culture);
    private static string Percent(decimal value) => value.ToString("N2", Culture) + "%";
    private static string Invariant(decimal value) => value.ToString("0.################", CultureInfo.InvariantCulture);
    private static decimal Ratio(int count, int total) => total > 0 ? (decimal)count / total * 100 : 0;
    private decimal StockPercent => snapshot is null ? 0 : Ratio(snapshot.ProductsInStock, snapshot.ProductCount);
    private decimal ProfitScale => snapshot is null ? 1 : snapshot.HighestProfit.Concat(snapshot.LowestProfit).Select(p => Math.Abs(p.ProfitPercent)).DefaultIfEmpty(0).Max();
    private static string Coverage(int count, int total) => total == 0 ? "Sin unidades" : count < total ? $"Valor parcial · {count} / {total} con datos" : $"{count} / {total} con datos";
    private static string NoticeTitle(NoticeKind kind) => kind switch { NoticeKind.SellingAtLoss => "Venta por debajo del costo", NoticeKind.OutOfStock => "Sin stock", _ => "Ganancia crítica" };
}
