@page "/perfil"
@rendermode InteractiveServer
@using Aquarella.Models
@inject Aquarella.Services.BusinessProfileStore ProfileStore

<PageTitle>Perfil del negocio · Aquarella</PageTitle>

<main class="module-page business-profile">
    <BackToDashboard />
    <h1>Perfil del negocio</h1>
    <p class="intro">Identidad y datos de tu negocio. Este perfil es independiente de tu cuenta personal.</p>

    <EditForm Model="profile" OnValidSubmit="Save" OnInvalidSubmit="InvalidSave" FormName="business-profile" novalidate>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <section class="profile-section" aria-labelledby="identity-title">
            <h2 id="identity-title">Identidad</h2>
            <div class="identity-grid">
                <div class="logo-field">
                    <label for="business-logo">Logo del negocio</label>
                    <div class="logo-preview">
                        @if (!string.IsNullOrWhiteSpace(profile.LogoDataUrl))
                        {
                            <img src="@profile.LogoDataUrl" alt="Logo del negocio" />
                        }
                        else
                        {
                            <span aria-hidden="true">A</span>
                        }
                    </div>
                    <InputFile id="business-logo" OnChange="LoadLogo" accept="image/png,image/jpeg,image/webp" />
                    <p class="hint">PNG, JPG o WebP · hasta 2 MB. Vista previa local.</p>
                    @if (profile.LogoDataUrl is not null)
                    {
                        <button type="button" class="text-button" @onclick="RemoveLogo">Quitar logo</button>
                    }
                    @if (logoError is not null) { <p class="field-error" role="alert">@logoError</p> }
                </div>
                <div class="field-grid identity-fields">
                    <div class="field full-width">
                        <label for="business-name">Nombre del negocio</label>
                        <input id="business-name" @bind="profile.Name" maxlength="120" @bind:event="oninput" />
                        <ValidationMessage For="() => profile.Name" />
                    </div>
                    <div class="field full-width">
                        <label for="business-description">Descripción</label>
                        <textarea id="business-description" @bind="profile.Description" rows="4" maxlength="1000" placeholder="Contá qué ofrece tu negocio…" @bind:event="oninput"></textarea><OptionalFieldWarning Value="@profile.Description" Label="Descripción" />
                    </div>
                </div>
            </div>
        </section>

        <section class="profile-section" aria-labelledby="colors-title">
            <h2 id="colors-title">Personalización</h2>
            <p class="hint">Explorá tu paleta. Al guardar, esta paleta se aplica a toda la aplicación.</p>
            <div class="color-grid">
                <div><ColorField Id="primary-color" Label="Color primario" @bind-Value="profile.PrimaryColor" /><ValidationMessage For="() => profile.PrimaryColor" /></div>
                <div><ColorField Id="secondary-color" Label="Color secundario" @bind-Value="profile.SecondaryColor" /><ValidationMessage For="() => profile.SecondaryColor" /></div>
                <div><ColorField Id="tertiary-color" Label="Color terciario" @bind-Value="profile.TertiaryColor" /><ValidationMessage For="() => profile.TertiaryColor" /></div>
            </div>
        </section>

        <section class="profile-section" aria-labelledby="contact-title">
            <h2 id="contact-title">Contacto</h2>
            <div class="field-grid">
                <div class="field"><label for="business-phone">Teléfono / WhatsApp</label><input id="business-phone" type="tel" @bind="profile.Phone" placeholder="+54 …" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.Phone" Label="Teléfono" /></div>
                <div class="field"><label for="business-email">Email</label><input id="business-email" type="email" @bind="profile.Email" placeholder="contacto@negocio.com" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.Email" Label="Email" /><ValidationMessage For="() => profile.Email" /></div>
                <div class="field full-width"><label for="business-website">Sitio web</label><input id="business-website" type="url" @bind="profile.Website" placeholder="https://…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.Website" Label="Sitio web" /><ValidationMessage For="() => profile.Website" /></div>
            </div>
        </section>

        <section class="profile-section" aria-labelledby="social-title">
            <h2 id="social-title">Redes del negocio</h2>
            <div class="field-grid">
                <div class="field"><label for="instagram">Instagram</label><input id="instagram" @bind="profile.Instagram" placeholder="https://instagram.com/…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.Instagram" Label="Instagram" /><ValidationMessage For="() => profile.Instagram" /></div>
                <div class="field"><label for="facebook">Facebook</label><input id="facebook" @bind="profile.Facebook" placeholder="https://facebook.com/…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.Facebook" Label="Facebook" /><ValidationMessage For="() => profile.Facebook" /></div>
                <div class="field"><label for="tiktok">TikTok</label><input id="tiktok" @bind="profile.TikTok" placeholder="https://tiktok.com/…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.TikTok" Label="TikTok" /><ValidationMessage For="() => profile.TikTok" /></div>
                <div class="field"><label for="x-network">X</label><input id="x-network" @bind="profile.X" placeholder="https://x.com/…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.X" Label="X" /><ValidationMessage For="() => profile.X" /></div>
                <div class="field"><label for="linkedin">LinkedIn</label><input id="linkedin" @bind="profile.LinkedIn" placeholder="https://linkedin.com/…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.LinkedIn" Label="LinkedIn" /><ValidationMessage For="() => profile.LinkedIn" /></div>
                <div class="field"><label for="youtube">YouTube</label><input id="youtube" @bind="profile.YouTube" placeholder="https://youtube.com/…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.YouTube" Label="YouTube" /><ValidationMessage For="() => profile.YouTube" /></div>
            </div>
        </section>

        <section class="profile-section" aria-labelledby="details-title">
            <h2 id="details-title">Información del negocio</h2>
            <div class="field-grid">
                <div class="field"><label for="industry">Rubro</label><input id="industry" @bind="profile.Industry" placeholder="Ej.: gastronomía, estética, comercio…" @bind:event="oninput" /><OptionalFieldWarning Value="@profile.Industry" Label="Rubro" /></div>
                <div class="field"><label for="hours">Horario de atención</label><textarea id="hours" @bind="profile.Hours" rows="3" placeholder="Lunes a viernes, 9:00 a 18:00" @bind:event="oninput"></textarea><OptionalFieldWarning Value="@profile.Hours" Label="Horario" /></div>
            </div>
        </section>

        <div class="save-bar">
            <p class="hint">Se guarda en este navegador y se conserva al recargar.</p>
            <button class="save-button" type="submit" disabled="@(loadingLogo || saving || !ready)">@(loadingLogo ? "Procesando logo…" : "Guardar cambios")</button>
        </div>
        <p class="save-status" role="status" aria-live="polite">@status</p>
    </EditForm>
</main>

@code {
    private BusinessProfile profile = new();
    private string? status;
    private string? logoError;
    private bool loadingLogo;
    protected override void OnInitialized() => profile = ProfileStore.Load();
    private bool ready;
    private bool saving;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await ProfileStore.InitializeAsync(); profile = ProfileStore.Load(); ready = true; }
        catch (Microsoft.JSInterop.JSException) { status = "No se pudo acceder al almacenamiento de este navegador."; }
        StateHasChanged();
    }
    private async Task Save()
    {
        saving = true;
        try { await ProfileStore.SaveAsync(profile); status = "Perfil guardado. La identidad del negocio ya está actualizada."; }
        catch (Microsoft.JSInterop.JSException) { status = "No se pudo guardar. Revisá el espacio o los permisos de almacenamiento del navegador."; }
        finally { saving = false; }
    }
    private void InvalidSave(EditContext context) => status = "Revisá los campos indicados antes de guardar.";
    private void RemoveLogo() { profile.LogoDataUrl = null; logoError = null; }
    private async Task LoadLogo(InputFileChangeEventArgs args)
    {
        logoError = null;
        loadingLogo = true;
        try
        {
            var file = args.File;
            if (file.Size > 2 * 1024 * 1024 || !new[] { "image/png", "image/jpeg", "image/webp" }.Contains(file.ContentType))
            {
                logoError = "Elegí una imagen PNG, JPG o WebP de hasta 2 MB.";
                return;
            }
            var resized = await file.RequestImageFileAsync("image/png", 400, 400);
            await using var stream = resized.OpenReadStream(2 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            profile.LogoDataUrl = $"data:image/png;base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            logoError = "No pudimos leer la imagen. Probá con otro archivo.";
        }
        finally { loadingLogo = false; }
    }
}





