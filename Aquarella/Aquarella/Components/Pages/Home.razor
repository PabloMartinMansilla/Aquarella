@page "/"

<PageTitle>Inicio · Aquarella</PageTitle>

<main class="dashboard">
    <section class="welcome-banner" aria-labelledby="welcome-title">
        <span class="module-icon welcome-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="@ModuleCatalog.All.First(module => module.Accent == "metrics").IconPath" /></svg>
        </span>
        <div>
            <h2 id="welcome-title">¡Bienvenido a Aquarella!</h2>
            <p>Todo tu negocio, en un solo lugar.</p>
        </div>
    </section>
    <div class="section-heading">
        <div>
            <p class="eyebrow scroll-reveal">TU ESPACIO DE TRABAJO</p>
            <h1 class="scroll-reveal">Paneles principales</h1>
        </div>
        <p class="scroll-reveal">Todo lo que necesitás, en un solo lugar.</p>
    </div>
    <section id="tour-panels" class="module-grid" aria-label="Paneles principales">
        @foreach (var module in ModuleCatalog.All)
        {
            <a id="tour-card-@module.Accent" class="module-card scroll-reveal @module.Accent" href="@module.Route">
                <div class="card-top">
                    <span class="module-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="@module.IconPath" /></svg>
                    </span>
                    <span class="card-arrow" aria-hidden="true">↗</span>
                </div>
                <h2>@module.Title</h2>
                <p>@module.Description</p>
            </a>
        }
</section>
    <CreatorCredits />
</main>




<OnboardingTour />

