@page "/precios"
@rendermode InteractiveServer
@using Aquarella.Models
@using System.Globalization
@implements IDisposable
@inject Aquarella.Services.BusinessData Data
@inject ILogger<Precios> Logger

<PageTitle>Precios · Aquarella</PageTitle>
<main class="module-page prices-page">
    <BackToDashboard />
    <h1>Precios</h1>
    <p class="intro">Productos de Stock. Los cambios se calculan y guardan automáticamente.</p>
    <p class="status" data-feedback role="status" aria-live="polite">@status</p>
    @if (!ready) { <p>@(failed ? "No se pudieron cargar los datos. Recargá para volver a intentar." : "Cargando precios…")</p> }
    else if (products.Count == 0) { <div class="empty-state">Todavía no hay productos. <a href="/stock">Agregalos en Stock</a> para configurar sus precios.</div> }
    else
    {
        <p class="table-hint" id="prices-scroll-hint">Deslizá la tabla hacia los lados para ver todos los precios.</p>
        <div class="table-container" tabindex="0" aria-label="Tabla de precios, desplazable horizontalmente" aria-describedby="prices-scroll-hint">
            <table>
                <thead><tr><th scope="col">Producto</th><th scope="col">Precio de compra</th><th scope="col">% de ganancia deseada</th><th scope="col">Precio sugerido</th><th scope="col">Precio de venta</th><th scope="col">Ganancia real</th></tr></thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        var price = prices[product.Id];
                        <tr @key="product.Id">
                            <th scope="row"><div class="price-product"><ProductThumbnail Product="product" /><span>@product.Name</span></div></th>
                            <td><input type="text" inputmode="decimal" lang="es-AR" value="@InputValue(price, 0)" aria-label="Precio de compra de @product.Name" @oninput="e => Change(price, 0, e)" @onblur="() => EndEdit(price.ProductId, 0)" /></td>
                            <td><input type="text" inputmode="decimal" lang="es-AR" value="@InputValue(price, 1)" aria-label="Porcentaje de ganancia de @product.Name" @oninput="e => Change(price, 1, e)" @onblur="() => EndEdit(price.ProductId, 1)" /></td>
                            <td class="calculated">@Money(price.SuggestedPrice)</td>
                            <td><input type="text" inputmode="decimal" lang="es-AR" value="@InputValue(price, 2)" aria-label="Precio de venta de @product.Name" @oninput="e => Change(price, 2, e)" @onblur="() => EndEdit(price.ProductId, 2)" />
                                @if (price.ManualSalePrice) { <button class="reset-button" @onclick="() => UseSuggested(price)" aria-label="Usar precio sugerido para @product.Name">Usar sugerido</button> }
                            </td>
                            <td class="calculated">@Money(price.RealProfit)<small>@(price.ProfitPercentOverCost is not decimal percentage ? "Sin porcentaje: costo cero" : $"{percentage.ToString("N2", CultureInfo.GetCultureInfo("es-AR"))}% sobre el costo")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="note">Precio sugerido = compra × (1 + porcentaje / 100). Ganancia real por unidad = venta − compra. El precio de venta sigue al sugerido hasta que lo editás manualmente.</p>
</main>

@code {
    private List<StockProduct> products = [];
    private Dictionary<Guid, ProductPrice> prices = [];

    protected override void OnInitialized() => Data.NoticesChanged += ProductsChanged;
    private bool refreshPending, refreshing;
    private void ProductsChanged() { if (!disposed) _ = RefreshAfterChange(); }
    private async Task RefreshAfterChange()
    {
        try { await InvokeAsync(async () => {
            if (disposed) return;
            refreshPending = true;
            if (refreshing) return;
            refreshing = true;
            try { while (refreshPending && !disposed) { refreshPending = false; await RefreshStock(); } }
            finally { refreshing = false; }
        }); }
        catch (Exception e) when (disposed && e is OperationCanceledException or ObjectDisposedException or InvalidOperationException) { }
        catch (Exception e) { Logger.LogWarning(e, "Price view refresh failed."); }
    }
    private readonly SemaphoreSlim saveLock = new(1, 1);
    private readonly Dictionary<Guid, long> revisions = [];
    private readonly Dictionary<Guid, int> pendingEdits = [];
    private readonly CancellationTokenSource lifetime = new();
    private bool disposed;
    private bool ready, failed;
    private string? status;
    private static readonly CultureInfo PriceCulture = CultureInfo.GetCultureInfo("es-AR");
    private readonly Dictionary<(Guid ProductId, int Field), string> inputDrafts = [];
    private static string Number(decimal value) => value.ToString(value == decimal.Truncate(value) ? "N0" : "#,0.00##########################", PriceCulture);
    private string InputValue(ProductPrice price, int field) => inputDrafts.TryGetValue((price.ProductId, field), out var draft) ? draft : Number(field == 0 ? price.Cost : field == 1 ? price.DesiredProfitPercent : price.EffectiveSalePrice);
    private void EndEdit(Guid productId, int field) => inputDrafts.Remove((productId, field));
    private static bool TryNumber(string text, out decimal value)
    {
        value = 0;
        // .NET accepts irregular thousands groups; reject ambiguous text such as "2.0".
        return System.Text.RegularExpressions.Regex.IsMatch(text.Trim(), @"^[+-]?(?:[0-9]+|[0-9]{1,3}(?:\.[0-9]{3})+)(?:,[0-9]*)?$")
            && decimal.TryParse(text, NumberStyles.Number, PriceCulture, out value);
    }
    private static string Money(decimal value) => value.ToString("N2", CultureInfo.GetCultureInfo("es-AR"));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed) return;
        try {

            await Load();


            if (!disposed) ready = true;
        } catch (OperationCanceledException) when (disposed) { return;
        } catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { failed = true; status = "No se pudo acceder al almacenamiento. Los datos guardados se conservaron."; }
        if (!disposed) StateHasChanged();
    }
    private async Task Load(bool preserveDrafts = false)
    {
        if (disposed) return;
        var token = lifetime.Token;
        var loadedProducts = await Data.LoadProductsAsync(token);
        var loadedPrices = (await Data.LoadPricesAsync(token)).ToDictionary(p => p.ProductId);
        foreach (var product in loadedProducts) loadedPrices.TryAdd(product.Id, new ProductPrice { ProductId = product.Id });
        if (preserveDrafts) foreach (var product in loadedProducts)
            if (pendingEdits.GetValueOrDefault(product.Id) > 0 && prices.TryGetValue(product.Id, out var draft)) loadedPrices[product.Id] = draft;
        if (!disposed) { products = loadedProducts; prices = loadedPrices; }
    }
    public async Task RefreshStock()
    {
        if (disposed) return;
        try { await saveLock.WaitAsync(lifetime.Token); }
        catch (OperationCanceledException) when (disposed) { return; }
        try { await Load(preserveDrafts: true); if (!disposed && !pendingEdits.Values.Any(n => n > 0)) status = "Precios sincronizados."; }
        catch (OperationCanceledException) when (disposed) { }
        catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { status = "No se pudo sincronizar Stock. Los datos anteriores se conservaron."; }
        finally { saveLock.Release(); }
        if (!disposed) await InvokeAsync(StateHasChanged);
    }
    private async Task Change(ProductPrice price, int field, ChangeEventArgs args)
    {
        if (disposed) return;
        var text = args.Value?.ToString() ?? "";
        inputDrafts[(price.ProductId, field)] = text;
        if (!TryNumber(text, out var value) || value < 0 || value > (field == 0 ? 1_000_000_000m : field == 1 ? 10_000m : 1_000_000_000_000m)) { status = "Ingresá un número válido, sin valores negativos y dentro del rango permitido."; return; }
        if (field == 0) price.Cost = value;
        else if (field == 1) price.DesiredProfitPercent = value;
        else { price.SalePrice = value; price.ManualSalePrice = true; }
        await Save(new(price.ProductId, (PriceField)field, value));
    }
    private async Task UseSuggested(ProductPrice price) { if (disposed) return; price.ManualSalePrice = false; await Save(new(price.ProductId, PriceField.Suggested)); }
    private async Task Save(PriceEdit edit)
    {
        if (disposed) return;
        var revision = revisions.GetValueOrDefault(edit.ProductId) + 1;
        revisions[edit.ProductId] = revision;
        pendingEdits[edit.ProductId] = pendingEdits.GetValueOrDefault(edit.ProductId) + 1;
        status = "Guardando cambios…";
        await saveLock.WaitAsync();
        try
        {
            var actual = await Data.ApplyPriceEditAsync(edit);
            if (!disposed && revisions[edit.ProductId] == revision) { prices[edit.ProductId] = actual; status = "Cambios guardados."; }
        }
        catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e))
        {
            if (disposed || revisions[edit.ProductId] != revision) return;
            EndEdit(edit.ProductId, (int)edit.Field);
            status = "No se pudieron guardar los cambios. Revisá la conexión o permisos de la base de datos.";
            // Restore the persisted value, not the optimistic draft. Keep loading failures explicit.
            try { await Load(); }
            catch (OperationCanceledException) when (disposed) { }
            catch (Exception reloadError) when (Aquarella.Services.PersistenceErrors.IsStorageError(reloadError)) { ready = false; failed = true; }
        }
        finally { pendingEdits[edit.ProductId]--; saveLock.Release(); }
    }
    public void Dispose() { if (disposed) return; disposed = true; Data.NoticesChanged -= ProductsChanged; lifetime.Cancel(); lifetime.Dispose(); }
}





