@page "/stock"
@rendermode InteractiveServer
@using Aquarella.Models
@using System.ComponentModel.DataAnnotations

@inject Aquarella.Services.BusinessData Data

<PageTitle>Stock · Aquarella</PageTitle>
<main class="module-page stock-page">
    <BackToDashboard />
    <div class="stock-heading"><h1>Stock</h1><div class="stock-actions"><button class="primary-button" disabled="@(!ready || busy)" @onclick="NewProduct">+ Agregar producto</button><button class="quiet-button" disabled="@(!ready || busy)" @onclick="OpenInvoice">Cargar factura</button></div></div>
    @if (invoiceOpen)
    {
        <StockInvoiceImport Products="products" Saved="ReloadProducts" Closed="() => invoiceOpen = false" BusyChanged="value => busy = value" />
    }
    @if (editing)
    {
        <section class="product-form"><EditForm EditContext="editContext" @key="editContext" OnValidSubmit="SaveProduct" OnInvalidSubmit="InvalidProduct">
            <DataAnnotationsValidator />
            <h2>@(editId is null ? "Agregar producto" : "Editar producto")</h2>
            <div class="form-fields">
                <div><label for="stock-product-name">Nombre del producto</label><StockTextInput id="stock-product-name" @ref="nameInput" @bind-Value="form.Name" maxlength="120" disabled="@busy" /><ValidationMessage For="() => form.Name" /></div>
                <div><label for="stock-product-quantity">@(editId is null ? "Cantidad a agregar" : "Cantidad actual")</label><StockNumberInput id="stock-product-quantity" @bind-Value="form.Quantity" min="0" max="2147483647" disabled="@busy" ParsingErrorMessage="Ingresá una cantidad entera válida." /><ValidationMessage For="() => form.Quantity" /></div>
            </div>
            <div class="form-actions"><button class="primary-button" aria-busy="@busy" disabled="@busy" type="submit">@(editId is null ? "Agregar producto" : "Guardar cambios")</button><button class="quiet-button" disabled="@busy" type="button" @onclick="() => editing = false">@(editId is null ? "Cerrar" : "Cancelar")</button></div>
        </EditForm></section>
    }
    <p class="status" data-feedback role="status" aria-live="polite">@status</p>
    <section class="product-list" aria-label="Productos">
        @if (!ready) { <p class="empty-state">@(loadFailed ? "No se pudo cargar el stock. Recargá la página para volver a intentar." : "Cargando productos…")</p> }
        else if (products.Count == 0) { <div class="empty-state"><p>Todavía no tenés productos.</p>@if (!editing) { <button class="primary-button" disabled="@busy" @onclick="NewProduct">Agregar el primero</button> }</div> }
        @foreach (var product in products)
        {
            <article class="product-row" @key="product.Id">
                <div class="product-info"><h2>@product.Name</h2><p>Cantidad actual: <strong>@product.Quantity</strong></p></div>
                <div class="adjustment">
                    <label for="adjust-@product.Id">Ajuste de cantidad</label>
                    <div class="adjustment-controls">
                        <button class="step-button" disabled="@busy" aria-label="Restar a @product.Name" @onclick="() => Step(product.Id, -1)">−</button>
                        <input id="adjust-@product.Id" type="number" @bind="adjustments[product.Id]" @bind:event="oninput" aria-label="Ajuste de cantidad de @product.Name" />
                        <button class="step-button" disabled="@busy" aria-label="Sumar a @product.Name" @onclick="() => Step(product.Id, 1)">+</button>
                        <button class="primary-button" disabled="@busy" @onclick="() => Confirm(product)">Confirmar</button>
                    </div>
                </div>
                <div class="row-actions">
                    <button class="quiet-button" disabled="@busy" aria-label="Editar @product.Name" @onclick="() => Edit(product)">Editar</button>
                    <button class="quiet-button" disabled="@busy" aria-label="Eliminar @product.Name" @onclick="() => deleteId = product.Id">Eliminar</button>
                </div>
                @if (deleteId == product.Id)
                {
                    <div class="delete-confirm">¿Eliminar @product.Name? <button class="quiet-button" disabled="@busy" @onclick="() => Delete(product.Id)">Sí, eliminar</button><button class="quiet-button" disabled="@busy" @onclick="() => deleteId = null">Cancelar</button></div>
                }
            </article>
        }
    </section>
    <p class="storage-note">Los productos se guardan en la base de datos y se conservan al recargar. Usá ajustes positivos para sumar y negativos para restar.</p>
</main>

@code {
    private List<StockProduct> products = [];
    private readonly Dictionary<Guid, int> adjustments = [];

    private bool ready, busy, editing, loadFailed, invoiceOpen, focusName;
    private Guid? editId, deleteId;
    private ProductForm form = new();
    private EditContext editContext = null!;
    private StockTextInput? nameInput;
    private string operationKey = Guid.NewGuid().ToString("N");
    private string? status;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusName && nameInput is not null) { focusName = false; await nameInput.InputElement.FocusAsync(); }
        if (!firstRender) return;
        try
        {
            products = await Data.LoadProductsAsync();
            foreach (var product in products) adjustments[product.Id] = 0;
            ready = true;
        }
        catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { loadFailed = true; status = "No se pudo acceder a los productos guardados. No se sobrescribieron los datos."; }
        StateHasChanged();
    }
    private void ResetForm(string name = "", int? quantity = null) { form = new() { Name = name, Quantity = quantity }; editContext = new(form); editContext.OnFieldChanged += (_, _) => status = null; focusName = true; }
    private void NewProduct() { editId = null; ResetForm(); editing = true; invoiceOpen = false; status = null; operationKey = Guid.NewGuid().ToString("N"); }
    private void OpenInvoice() { editing = false; invoiceOpen = true; status = null; }
    private void Edit(StockProduct product) { editId = product.Id; ResetForm(product.Name, product.Quantity); editing = true; invoiceOpen = false; status = null; }
    private async Task ReloadProducts() { products = await Data.LoadProductsAsync(); foreach (var product in products) adjustments.TryAdd(product.Id, 0); }
    private void Step(Guid id, int step)
    {
        var value = (long)adjustments[id] + step;
        if (value >= int.MinValue && value <= int.MaxValue) adjustments[id] = (int)value;
    }
    private async Task SaveProduct()
    {
        if (busy || !ready) return;
        if (editId is Guid id)
        {
            if (await Persist(() => Data.SaveProductAsync(new(id, form.Name.Trim(), form.Quantity!.Value), false)))
            { adjustments[id] = 0; editing = false; status = "Producto guardado."; }
            return;
        }
        StockIntakeOutcome? outcome = null;
        if (await Persist(async () => outcome = await Data.ApplyStockIntakeAsync([new(form.Name, form.Quantity!.Value)], operationKey)))
        {
            var result = outcome!.Lines.Single();
            status = outcome.AlreadyApplied ? "Esta carga ya estaba guardada; no se duplicó." : result.Created ? $"Producto agregado: {result.Name}." : $"Producto actualizado: +{result.AddedQuantity} unidades. Stock actual: {result.FinalQuantity}.";
            ResetForm(); operationKey = Guid.NewGuid().ToString("N");
        }
    }
    private void InvalidProduct() => status = "Revisá los campos marcados antes de guardar el producto.";
    private async Task Confirm(StockProduct product)
    {
        var result = (long)product.Quantity + adjustments[product.Id];
        if (result < 0 || result > int.MaxValue) { status = "La cantidad final debe estar entre 0 y 2.147.483.647."; return; }
        if (await Persist(() => Data.AdjustAsync(product.Id, adjustments[product.Id])))
        { adjustments[product.Id] = 0; if (editId == product.Id) editing = false; status = "Cantidad actualizada."; }
    }
    private async Task Delete(Guid id)
    {
        if (await Persist(() => Data.DeleteProductAsync(id)))
        { adjustments.Remove(id); deleteId = null; if (editId == id) editing = false; status = "Producto eliminado."; }
    }
    private async Task<bool> Persist(Func<Task> operation)
    {
        if (busy || !ready) return false;
        busy = true;
        try { await operation(); await ReloadProducts(); return true; }
        catch (ValidationException e) { status = e.Message; return false; }
        catch (Exception e) when (Aquarella.Services.PersistenceErrors.IsStorageError(e)) { status = "No se pudo completar el guardado o actualizar la lista. Revisá la conexión o permisos de la base de datos. Si estabas agregando un producto, podés reintentar la misma carga sin duplicarla."; return false; }
        finally { busy = false; }
    }

    private sealed class ProductForm
    {
        [Required(ErrorMessage = "Ingresá el nombre del producto."), StringLength(120, ErrorMessage = "El nombre admite hasta 120 caracteres.")]
        public string Name { get; set; } = "";
        [Required(ErrorMessage = "Ingresá la cantidad."), Range(0, int.MaxValue, ErrorMessage = "La cantidad debe estar entre 0 y 2.147.483.647.")]
        public int? Quantity { get; set; }
    }

}






